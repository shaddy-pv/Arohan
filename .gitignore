# ============================================================
# AROHAN — .gitignore
# ============================================================

# ------ Node / Frontend ------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ------ Python / Backend ------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# ------ Environment & Secrets (NEVER COMMIT) ------
.env
.env.*
!.env.example
backend/firebase-credentials.json
firebase-credentials.json
service-account*.json
*-service-account*.json
google-credentials.json
gcloud-credentials.json
secrets/

# ------ ML Models & Binaries ------
*.pkl
*.caffemodel
*.prototxt
*.h5
*.onnx
*.pt
*.pth
*.bin
*.weights

# ------ Runtime Snapshots (generated by backend) ------
backend/static/snapshots/
backend/static/captures/

# ------ Dataset Files (too large for git) ------
datasets/
*.ipynb
*.csv
*.parquet
*.arrow
*.feather

# ------ Sensitive / Personal Data ------
ronin-80b29-default-rtdb-export.json
*.db-export.json
backend/known_faces/*/WhatsApp*
backend/known_faces/*/photo*.jpg
AROHAN_Rover_FINAL/dataset/Tech Lead/

# ------ Firebase ------
.firebase/
.firebaserc.local

# ------ Vercel ------
.vercel/

# ------ Editor ------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.DS_Store
Thumbs.db

# ------ HuggingFace upload scripts with tokens ------
upload_hf.py

# ------ Misc ------
*.bak
*.tmp
*.orig
server/