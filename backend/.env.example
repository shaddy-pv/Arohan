# ============================================================
# AROHAN Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ------ ESP32-CAM ------
ESP32_CAM_URL=http://192.168.1.100:81

# ------ Backend ------
BACKEND_URL=http://localhost:5000

# ------ Face Recognition Tuning ------
FACE_DETECTOR_MODE=haar           # Options: haar | dnn | both
FR_DISTANCE_THRESHOLD=0.55        # Lower = stricter match (0.4 – 0.7)
CONFIDENCE_THRESHOLD=0.55
BLUR_THRESHOLD=40                 # Reject blurry frames below this value

# ------ Memory Management ------
MAX_ALERTS=1000
MAX_SNAPSHOTS=200

# ------ Performance ------
FACE_RECOGNITION_TIMEOUT=3.0

# ------ Firebase Admin SDK ------
# Download your service account key from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_CREDENTIALS=firebase-credentials.json   # Path to your downloaded JSON key

# ------ Twilio WhatsApp Alerts ------
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WA_FROM=whatsapp:+14155238886             # Twilio sandbox number
TWILIO_WA_TO=whatsapp:+91XXXXXXXXXX             # Your WhatsApp number

# ------ Twilio Voice Calls ------
TWILIO_CALL_FROM=+1XXXXXXXXXX                   # Your Twilio phone number
TWILIO_CALL_TO=+91XXXXXXXXXX                    # Target phone number

# ------ Rover Control ------
ROVER_URL=http://arohan.local                   # mDNS hostname of the rover
